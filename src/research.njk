---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.prefix }}/research/"
section: research
eleventyComputed:
  lang: "{{ locale.lang }}"
  title: "{{ locale.research }}"
---
{% set ui = locale %}
{% from 'papers.njk' import paperList %}
<header class="page-heading research-heading"><h1>{{ ui.research }}</h1><a href="https://scholar.google.com/citations?user=NX7qkNAAAAAJ&amp;hl=en">Google Scholar ↗</a></header>
<section class="research-section"><h2>{{ '已发表论文' if ui.prefix else 'Publications' }}</h2>
{{ paperList(papers.published,ui,false,reviewAbstracts,preview) }}</section>
<section class="research-section"><h2>Working papers</h2>
{{ paperList(papers.working,ui,true,reviewAbstracts,preview) }}</section>
