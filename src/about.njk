---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.prefix }}/about/"
section: about
pageClass: about-page
eleventyComputed:
  lang: "{{ locale.lang }}"
  title: "{{ locale.about }}"
---
{% set ui = locale %}
{% if ui.prefix %}
<header class="page-heading"><h1>侯煜欣</h1></header><div class="prose"><p class="profile-identity">{{ ui.identity }}</p><p>{{ ui.heroText }}</p><p>{{ ui.aboutMore }}</p><p>{{ ui.approach }}</p><div class="resume-links">{% include 'resume-links.njk' %}</div>
{% include 'timeline.njk' %}{% include 'sports.njk' %}<h2>联系</h2><p><a href="mailto:{{ site.email }}">{{ site.email }}</a> · <a href="{{ site.github }}">GitHub / houx15</a></p></div>
{% else %}

<header class="page-heading">

<h1>Yuxin Hou <span lang="zh-CN">侯煜欣</span>
</h1>
</header>
<div class="prose">
<p class="profile-identity">{{ ui.identity }}</p>
<p>{{ ui.heroText }}</p>
<p>{{ ui.aboutMore }}</p>
<p>{{ ui.approach }}</p>
<div class="resume-links">{% include 'resume-links.njk' %}</div>
{% include 'timeline.njk' %}{% include 'sports.njk' %}
<h2>Contact</h2>
<dl class="contact-list">
<dt>Email</dt>
<dd>
<a href="mailto:{{ site.email }}">{{ site.email }}</a>
</dd>
<dt>GitHub</dt>
<dd>
<a href="{{ site.github }}">github.com/houx15</a>
</dd>
</dl>
</div>

{% endif %}