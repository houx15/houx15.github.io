---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.prefix }}/"
pageClass: home-page
eleventyComputed:
  lang: "{{ locale.lang }}"
  description: "{{ locale.heroText }}"
---
{% set ui = locale %}
{% from 'entries.njk' import entryList %}
<section class="screen hero" aria-labelledby="intro-title"><div class="screen-inner hero-grid">
<div class="hero-copy"><p class="eyebrow">{{ ui.heroLabel }}</p><h1 id="intro-title">{% if ui.prefix %}<span class="display-line">让好奇心，</span><span class="display-line">跨越学科。</span>{% else %}{{ ui.heroTitle }}{% endif %}</h1><p class="hero-intro">{{ ui.heroText }}</p><p class="academic-role">{{ ui.role }}</p><a class="text-link" href="#projects">{{ ui.explore }} <span aria-hidden="true">↗</span></a></div>
<div class="hero-chat"><div class="sketch-wrap">{% include 'sketch.njk' %}<span class="sketch-note">{{ ui.sketchNote }}</span></div><div class="chat-entry-heading"><h2>{{ ui.assistant }}</h2><span class="mode-label">{{ ui.demo }}</span></div><p class="source-note">{{ ui.assistantNote }}</p>
<form id="hero-form" action="{{ ui.prefix }}/chat/"><label class="sr-only" for="hero-question">{{ ui.askLabel }}</label><fieldset disabled><div class="chat-input"><input id="hero-question" name="q" placeholder="{{ ui.placeholder }}" required maxlength="400" autocomplete="off"><button type="submit">{{ ui.start }} <span aria-hidden="true">↗</span></button></div></fieldset></form>
<div class="suggestions">{% for question in ui.starters %}<a href="{{ ui.prefix }}/chat/#topic={{ ['methods','ssdata','mind'][loop.index0] }}">{{ ui.starterLabels[loop.index0] }}</a>{% endfor %}</div><p class="source-note">{{ ui.demoNote }}</p><noscript><p>{{ ui.nojs }}</p></noscript></div>
<a class="next-screen" href="#interests"><span>01 / 03</span>{{ ui.meet }} <span aria-hidden="true">↓</span></a>
</div></section>
<section id="interests" class="screen profile-screen" aria-labelledby="about-title"><div class="screen-inner profile-grid"><div class="profile-copy"><p class="eyebrow">02 / {{ ui.about }}</p><h2 id="about-title">{% if ui.prefix %}<span class="display-line">问题，</span><span class="display-line">塑造了我的路径。</span>{% else %}{{ ui.aboutTitle }}{% endif %}</h2><p class="lead">{{ ui.aboutText }}</p><p>{{ ui.aboutMore }}</p><p>{{ ui.approach }}</p><a class="text-link" href="{{ ui.prefix }}/about/">{{ ui.about }} <span aria-hidden="true">↗</span></a></div><div class="profile-charts">{% include 'timeline.njk' %}{% include 'radar.njk' %}</div></div></section>
<section id="projects" class="screen work-screen"><div class="screen-inner"><div class="gallery-heading"><div><p class="eyebrow">03 / {{ ui.projects }}</p><h2>{{ ui.selected }}</h2></div><p>{{ ui.projectIntro }}</p></div>{% include 'project-cards.njk' %}
{% set allProjects = entries | localized(ui) | section('projects') %}{% set projects = allProjects | otherProjects(portfolio.projects) | selected %}{% if projects.length %}{{ entryList(projects,'h3',ui) }}{% elif not allProjects.length %}<p class="empty-state">{{ ui.noProjects }}</p>{% endif %}
<div class="notes-block"><div class="section-heading"><h2>{{ ui.notesTitle }}</h2><a href="{{ ui.prefix }}/reports/">{{ ui.allNotes }}</a></div>{% set reports = entries | localized(ui) | section('reports') | firstEntries %}{% if reports.length %}{{ entryList(reports,'h3',ui) }}{% else %}<p class="empty-state">{{ ui.noNotes }}</p>{% endif %}</div></div></section>
