---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.prefix }}/"
pageClass: home-page
eleventyComputed:
  lang: "{{ locale.lang }}"
  description: "{{ locale.heroText }}"
---
{% set ui = locale %}
{% from 'entries.njk' import entryList %}
<section class="screen hero comic-home" aria-labelledby="intro-title">
<h1 id="intro-title" class="sr-only">{{ ui.name }}</h1>
<a class="companion-portal" href="{{ ui.prefix }}/chat/" aria-label="{{ '和我聊聊，认识煜欣' if ui.prefix else 'Talk with me and meet Yuxin' }}">
  <span class="portal-character">{% include 'dumpling.njk' %}</span>
  <span class="portal-speech"><span class="portal-words"><span data-typewriter aria-hidden="true">{{ '嗨，要不要和我聊聊？' if ui.prefix else 'Hi. Want to talk for a bit?' }}</span></span><span class="sr-only">{{ '嗨，要不要和我聊聊？' if ui.prefix else 'Hi. Want to talk for a bit?' }}</span><svg class="portal-enter" viewBox="0 0 28 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 12C10 11 16 12 23 11M17 5l6 6-6 7"/></svg></span>
</a>
<a class="comic-leave" href="#interests" aria-label="{{ '向下阅读经历与作品' if ui.prefix else 'Scroll to the story and work' }}"><span aria-hidden="true">↓</span></a>
</section>
<section id="interests" class="screen profile-screen" aria-labelledby="about-title"><div class="screen-inner profile-grid"><div class="profile-copy"><p class="eyebrow">02 / {{ ui.about }}</p><h2 id="about-title">{{ ui.aboutTitle }}</h2><p class="lead">{{ ui.aboutText }}</p><p>{{ ui.aboutMore }}</p><p>{{ ui.approach }}</p><a class="text-link" href="{{ ui.prefix }}/about/">{{ ui.about }} <span aria-hidden="true">↗</span></a></div><div class="profile-charts">{% include 'timeline.njk' %}{% include 'radar.njk' %}</div></div></section>
<section id="research" class="screen work-screen" aria-labelledby="research-title"><div class="screen-inner"><div class="gallery-heading"><div><p class="eyebrow">03 / {{ ui.research }}</p><h2 id="research-title">{{ ui.research }}</h2></div><p>{{ ui.researchIntro }}</p></div>{% set cards = portfolio.research %}{% include 'project-cards.njk' %}<a class="text-link" href="{{ ui.prefix }}/research/">{{ ui.research }} <span aria-hidden="true">↗</span></a></div></section>
<section id="projects" class="screen work-screen" aria-labelledby="projects-title"><div class="screen-inner"><div class="gallery-heading"><div><p class="eyebrow">04 / {{ ui.projects }}</p><h2 id="projects-title">{{ ui.projects }}</h2></div><p>{{ ui.projectIntro }}</p></div>{% set cards = portfolio.projects %}{% set showDiagrams = true %}{% include 'project-cards.njk' %}
{% set items = entries | localized(ui) | section('projects') | products | otherProjects(portfolio.projects) | selected %}{% if items.length %}{{ entryList(items,'h3',ui) }}{% endif %}
<div class="notes-block"><div class="section-heading"><h2>{{ ui.notesTitle }}</h2><a href="{{ ui.prefix }}/reports/">{{ ui.allNotes }}</a></div>{% set reports = entries | localized(ui) | section('reports') | firstEntries %}{% if reports.length %}{{ entryList(reports,'h3',ui) }}{% else %}<p class="empty-state">{{ ui.noNotes }}</p>{% endif %}</div></div></section>
