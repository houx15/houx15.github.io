---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.prefix }}/"
pageClass: home-page
eleventyComputed:
  lang: "{{ locale.lang }}"
  description: "{{ locale.heroText }}"
---
{% set ui = locale %}
<link rel="stylesheet" href="/assets/home-profile.css?v={{ stylesheetVersion }}">
{% include 'home-scene.njk' %}
<div class="home-profile">
<section class="home-introduction" aria-labelledby="intro-title">
<div class="home-intro-copy"><h1 id="intro-title">{{ '侯煜欣' if ui.prefix else 'Yuxin Hou' }} <span>{{ 'monkey' if ui.prefix else 'monkey / 侯煜欣' }}</span></h1>
<p class="home-intro-lead">{{ ui.identity }}</p>
<p>{{ ui.heroText }}</p>
<p>{{ ui.aboutMore }}</p>
<p>{{ ui.approach }}</p>
<div class="home-intro-links"><a href="{{ ui.prefix }}/about/">{{ '更多关于我' if ui.prefix else 'More about me' }} ↗</a><a href="{{ ui.prefix }}/chat/">{{ '和我的 AI 分身聊聊' if ui.prefix else 'Talk with my AI companion' }} ↗</a></div></div>
<aside class="home-identity" aria-label="{{ '头像、关键词与链接' if ui.prefix else 'Avatar, interests and links' }}">
<img class="home-portrait" src="/assets/portrait.jpg" alt="{{ '侯煜欣的 GitHub 头像' if ui.prefix else 'Yuxin Hou’s GitHub avatar' }}" width="180" height="180">
<ul class="home-keywords"><li>{{ '创业' if ui.prefix else 'Entrepreneurship' }}</li><li>{{ '独立开发者' if ui.prefix else 'Independent developer' }}</li><li>{{ '技术与管理咨询' if ui.prefix else 'Technology & management consulting' }}</li><li>Computational Social Science</li></ul>
<div class="home-socials"><a href="{{ site.github }}">{% include 'icons/github.njk' %}<span>GitHub</span></a><a href="https://scholar.google.com/citations?user=NX7qkNAAAAAJ">{% include 'icons/scholar.njk' %}<span>Google Scholar</span></a><a href="https://www.xiaoyuzhoufm.com/podcast/69c0cc5b52e635e0091de4fe">{% include 'icons/podcast.njk' %}<span>{{ '涌现FM · 小宇宙' if ui.prefix else 'Podcast · 涌现FM' }}</span></a><a href="mailto:{{ site.email }}">{% include 'icons/mail.njk' %}<span>{{ '邮箱' if ui.prefix else 'Email' }}</span></a></div>
</aside></section>
<section class="home-research" aria-labelledby="recent-research"><div class="home-section-heading"><h2 id="recent-research">{{ '近期研究' if ui.prefix else 'Recent research' }}</h2><a href="{{ ui.prefix }}/research/">{{ '全部研究' if ui.prefix else 'All research' }} ↗</a></div>{% from 'papers.njk' import paperList %}{{ paperList(papers.published.slice(0,3),ui,false,{},false,true) }}</section>
<section class="home-updates" aria-labelledby="recent-updates"><div class="home-section-heading"><h2 id="recent-updates">{{ '最近动态' if ui.prefix else 'Recent updates' }}</h2><div><a href="{{ ui.prefix }}/projects/">{{ ui.projects }}</a> · <a href="{{ ui.prefix }}/writing/">{{ ui.writing }}</a></div></div>
<ul class="home-update-grid">
{% for slug in ['mind-imprint','cybersiliconvalley'] %}{% set item = entries | projectBySlug(slug) %}{% if item %}<li><a class="home-update-link" href="{{ item.url }}"><img src="{{ projectCovers[slug].url }}" alt="{{ item.title }} · 概念封面" width="600" height="375" loading="lazy"><div><p class="home-update-kind">{{ '项目' if ui.prefix else 'Project' }}</p><h3>{{ item.title }}</h3></div></a></li>{% endif %}{% endfor %}
{% for item in homeUpdates %}<li><a class="home-update-link home-update-writing" href="{{ item.url }}"><div><p class="home-update-kind">{{ '文章' if ui.prefix else 'Writing' }} · <time datetime="{{ item.date }}">{{ item.date }}</time></p><h3>{{ item.title }}</h3><p>{{ item.summary }}</p><span class="home-update-arrow" aria-hidden="true">↗</span></div></a></li>{% endfor %}
</ul></section></div>
