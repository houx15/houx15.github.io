<section id="sports"><h2>{{ '运动' if ui.prefix else 'Sport' }}</h2>
<p>{{ '我喜欢骑车、跑步、越野跑和 CrossFit。' if ui.prefix else 'I enjoy cycling, running, trail running and CrossFit.' }}</p>
<h3>{{ '近期参赛' if ui.prefix else 'Recent races' }}</h3>
<ul class="sports-records">{% for race in sports %}<li><time datetime="{{ race.date }}">{{ race.date }}</time><span>{% if race.url %}<a href="{{ race.url }}">{{ race.name[ui.lang] }}</a>{% else %}{{ race.name[ui.lang] }}{% endif %}</span><span class="race-distance">{{ race.distance[ui.lang] }}</span></li>{% endfor %}</ul>
</section>
