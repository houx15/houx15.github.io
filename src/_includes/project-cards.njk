<div class="selected-projects">
{% for project in cards %}{% set original = entries | projectBySlug(project.slug) %}{% set detail = original.zh if ui.prefix else original %}{% set copy = project.zh if ui.prefix else project %}
<article class="selected-project">{% if project.url and showDiagrams %}<div class="project-diagram" aria-hidden="true"><span class="project-number">0{{ loop.index }}</span>{% if loop.index == 1 %}<svg viewBox="0 0 280 150"><g fill="none" stroke="currentColor"><path d="M27 30h70v88H27z M183 30h70v88h-70z M39 47h46 M39 62h46 M39 77h46 M39 92h46 M195 47h46 M195 62h46 M195 77h46 M195 92h46" opacity=".5"/><circle cx="140" cy="74" r="20"/><path d="M97 74h23 M160 74h23 M129 75l8 8 15-19" stroke-width="1.5"/></g></svg>{% elif loop.index == 2 %}<svg viewBox="0 0 280 150"><g fill="none" stroke="currentColor"><path d="M45 25h68v92H45z M122 35h68v92h-68z M199 20h38v77h-38z"/><path d="M58 45h38 M58 57h29 M58 69h35 M137 55h36 M137 67h28 M137 79h30" opacity=".5"/><path d="M68 129 Q140 149 218 112" stroke-width="2"/></g></svg>{% else %}<svg viewBox="0 0 280 150"><g fill="none" stroke="currentColor"><path d="M30 30h42v25H30z M30 67h42v25H30z M30 104h42v25H30z M111 51h58v54h-58z M211 30h42v25h-42z M211 67h42v25h-42z M211 104h42v25h-42z"/><path d="M72 43L111 77 M72 80H111 M72 117L111 80 M169 78L211 43 M169 78H211 M169 78L211 117" opacity=".4"/></g></svg>{% endif %}</div>{% endif %}
<p class="project-category">{{ copy.tag }}</p><h3>{% if detail or project.url %}<a href="{{ detail.url if detail else project.url }}">{{ copy.name or project.name }}</a>{% else %}{{ copy.name or project.name }}{% endif %}</h3>{% if project.summary != project.name + "." and project.summary != project.name + "。" %}<p>{{ copy.summary }}</p>{% endif %}<p class="source-note">{{ copy.note }}</p><div class="project-reading-links">{% if detail %}<a href="{{ detail.url }}">{{ ui.read }} <span aria-hidden="true">↗</span></a>{% endif %}{% for link in project.links %}<a href="{{ link.url }}">{{ link.zh if ui.prefix else link.label }}</a>{% endfor %}{% if project.url %}<a href="{{ project.url }}">{{ ui.code }}</a>{% endif %}</div></article>{% endfor %}</div>