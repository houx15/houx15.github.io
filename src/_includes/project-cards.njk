<div class="selected-projects">
{% for project in portfolio.projects %}
{% set detail = entries | projectBySlug(project.slug) %}
<article class="selected-project">
  <p class="project-category">{{ project.tag }}</p>
  <h3><a href="{{ detail.url if detail else project.url }}">{{ project.name }}</a></h3>
  <p>{{ project.summary }}</p>
  <p class="source-note">{{ project.note }}</p>
  <div class="project-reading-links">{% if detail %}<a href="{{ detail.url }}">Read project</a>{% endif %}<a href="{{ project.url }}">Public code</a></div>
</article>
{% endfor %}
</div>
