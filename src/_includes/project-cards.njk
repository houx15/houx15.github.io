{% from 'product-gallery.njk' import productCard %}
<link rel="stylesheet" href="/assets/project-gallery.css?v={{ stylesheetVersion }}">
<ul class="product-grid selected-projects">{% for project in cards %}{% set original = entries | projectBySlug(project.slug) %}{% set detail = original %}{% if detail %}{{ productCard(detail,projectCovers[project.slug],ui,'h3') }}{% endif %}{% endfor %}</ul>
{% set featuredFallback = entries | localized(ui) | section('projects') | selected %}{% if not (entries | projectBySlug('mind-imprint')) and featuredFallback.length %}<ul class="product-grid">{% for item in featuredFallback %}{{ productCard(item,projectCovers[item.slug],ui,'h3') }}{% endfor %}</ul>{% endif %}
