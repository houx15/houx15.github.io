{% if ui.prefix %}{% set flows = [{id:'ssdata',title:'SSDataAgent · 评估路径',steps:['源数据与信息约束','拟合生成器','检查分布与记录复制'],note:'概念流程，不代表完整系统或实验结果。'},{id:'mind',title:'Mind Imprint · 从建议到行动',steps:['提出思考卡片','学生确认打开','提交完成并记录图操作'],note:'建议不等于自动完成；不同图操作有不同的材料要求。'},{id:'attitudes',title:'AI attitudes · 可恢复的标注',steps:['获取模型响应','区分有效标签与失败','存储分片；失败项可重试'],note:'处理可复核，不等于标签有效性或样本代表性已得到验证。'}] %}{% else %}{% set flows = [{id:'ssdata',title:'SSDataAgent · Evaluation path',steps:['Source data & information limits','Fit a generator','Check distributions & record copying'],note:'Conceptual flow, not the full system or experimental results.'},{id:'mind',title:'Mind Imprint · Suggestion to action',steps:['Propose a thinking card','Student chooses to open it','Complete & record graph effects'],note:'A suggestion does not complete a card; material requirements depend on the effect.'},{id:'attitudes',title:'AI attitudes · Resumable labeling',steps:['Receive model response','Separate valid labels from failures','Store parts; failed rows can retry'],note:'An inspectable process does not establish label validity or representativeness.'}] %}{% endif %}
{% for flow in flows %}<template id="visual-{{ flow.id }}"><figure class="answer-visual"><figcaption>{{ flow.title }}</figcaption><ol class="flow-diagram">{% for step in flow.steps %}<li><span class="flow-number">0{{ loop.index }}</span>{{ step }}</li>{% endfor %}</ol><p class="source-note">{{ flow.note }}</p></figure></template>{% endfor %}
<template id="visual-profile"><figure class="answer-visual"><figcaption>{{ ui.path }}</figcaption><ol class="flow-diagram"><li>{{ ui.before }}<strong>{{ ui.tsinghua }}</strong>{{ ui.degrees }}</li><li>{{ ui.since }}<strong>{{ ui.pku }}</strong>{{ ui.phd }}</li><li>{{ ui.concurrent }}<strong>{{ ui.princeton }}</strong>{{ ui.visit }}</li></ol><p class="source-note">{{ ui.timelineNote }}</p></figure></template>
<template id="visual-interests"><figure class="answer-visual"><figcaption>{{ ui.radar }} · {{ ui.illustrative }}</figcaption><svg class="answer-radar" viewBox="0 0 380 290" role="img" aria-label="{{ ui.radarNote }}">{% for ring in visualizations.rings %}<polygon points="{{ ring.points }}" fill="none" stroke="currentColor" opacity=".15"/>{% endfor %}<polygon points="{{ visualizations.initialPoints }}" fill="currentColor" fill-opacity=".08" stroke="currentColor"/><g font-size="12" text-anchor="middle" fill="currentColor">{% for axis in visualizations.axes %}<text x="{{ axis.labelPoint.x }}" y="{{ axis.labelPoint.y + 4 }}">{{ ui.domains[loop.index0] }}</text>{% endfor %}</g></svg><p class="source-note">{{ ui.radarNote }}</p></figure></template>
