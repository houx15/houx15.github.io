{% set ui = locales[1] if lang == 'zh-CN' or (page.url | isChinese) else locales[0] %}
{% set pageName = entry.author if article and entry.author else ui.name %}
<!doctype html>
<html lang="{{ lang or ui.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ pageName }}</title>
  {% if article and entry.author %}<meta name="author" content="{{ entry.author }}">{% endif %}
  <meta name="description" content="{{ description or ui.heroText }}">
  {% if preview or noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{% if article %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title or pageName }}">
  <meta property="og:description" content="{{ description or ui.heroText }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <link rel="stylesheet" href="/assets/style.css?v={{ stylesheetVersion }}">
  <link rel="stylesheet" href="/assets/companion.css?v={{ stylesheetVersion }}">
  <link rel="stylesheet" href="/assets/blog.css?v={{ stylesheetVersion }}">
  {% if article %}<link rel="stylesheet" href="/assets/katex/katex.min.css">{% endif %}
</head>
<body class="{{ pageClass }}">
  <a class="skip-link" href="#main">{{ ui.skip }}</a>
  <header class="site-header">
    <a class="site-name" href="{{ ui.prefix }}/"{% if page.url == '/' %} aria-current="page"{% endif %}>{{ pageName }}</a>
    <nav aria-label="{{ '主导航' if ui.prefix else 'Main navigation' }}">
      <a href="{{ ui.prefix }}/research/"{% if section == 'research' %} aria-current="page"{% endif %}>{{ ui.research }}</a>
      <a href="{{ ui.prefix }}/projects/"{% if section == 'projects' %} aria-current="page"{% endif %}>{{ ui.projects }}</a>
      <a href="{{ ui.prefix }}/writing/"{% if section == 'writing' or section == 'reports' or section == 'blog' or section == 'notes' %} aria-current="page"{% endif %}>{{ ui.writing }}</a>
      <a href="{{ ui.prefix }}/about/"{% if section == 'about' %} aria-current="page"{% endif %}>{{ ui.about }}</a>
      <a class="nav-resume" href="/assets/resumes/{{ 'Hou_Yuxin_Resume_CN.pdf' if ui.prefix else 'Yuxin_Hou_Resume_EN.pdf' }}">{{ '简历' if ui.prefix else 'Résumé' }}</a>
    </nav>
    <a class="language-switch" id="language-switch" href="{{ page.url | switchLanguage(entries, ui.lang) }}" hreflang="{{ 'en' if ui.prefix else 'zh-CN' }}" lang="{{ 'en' if ui.prefix else 'zh-CN' }}" aria-label="{{ ui.languageLabel }}">{{ ui.language }}</a>
  </header>
  <main id="main" tabindex="-1">
    {% if preview %}<p class="preview-notice">{{ ui.preview }}</p>{% endif %}
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <span>© {{ year }} {{ pageName }}</span>
    <div>
      <a class="privacy-link" href="{{ ui.prefix }}/privacy/" data-privacy-open>{{ '隐私条款' if ui.prefix else 'Privacy policy' }}</a>
      <a href="mailto:{{ site.email }}">{% include 'icons/mail.njk' %}<span>{{ ui.email }}</span></a>
      <a href="{{ site.github }}">{% include 'icons/github.njk' %}<span>GitHub</span></a>
    </div>
  </footer>
  <dialog class="privacy-dialog" id="privacy-dialog" aria-labelledby="privacy-dialog-title"><div class="privacy-dialog-header"><h2 id="privacy-dialog-title">{{ 'AI 助手与对话数据' if ui.prefix else 'AI assistant and conversation data' }}</h2><button type="button" data-privacy-close aria-label="{{ '关闭说明' if ui.prefix else 'Close notice' }}">×</button></div><div class="prose privacy-dialog-content">{% include 'assistant-privacy.njk' %}</div></dialog>
  <script type="module" src="/assets/privacy-dialog.js?v={{ assistantVersion }}"></script>
  {% if pageClass != 'chat-page' %}
  <button class="companion-launcher" type="button" data-companion-open aria-haspopup="dialog" aria-controls="companion-dialog" aria-label="{{ '打开团子的纸页，一起读' if ui.prefix or lang == 'zh-CN' else 'Open the guide’s page and read together' }}">{% include 'dumpling.njk' %}<span>{{ '一起读？' if ui.prefix or lang == 'zh-CN' else 'Read together?' }}</span></button>
  <dialog id="companion-dialog" class="comic-dialog" aria-label="{{ '团子的纸页' if ui.prefix or lang == 'zh-CN' else 'The guide’s page' }}"><div class="comic-panel-bar"><button type="button" class="comic-panel-handle" data-panel-drag aria-label="{{ '移动聊天窗口，可拖动或使用方向键' if ui.prefix or lang == 'zh-CN' else 'Move chat window: drag or use arrow keys' }}"><span aria-hidden="true">⠿</span> {{ '一起读' if ui.prefix or lang == 'zh-CN' else 'Read together' }}</button><button type="button" class="comic-close" data-companion-close aria-label="{{ '收起聊天' if ui.prefix or lang == 'zh-CN' else 'Close chat' }}">×</button></div>{% include 'companion.njk' %}</dialog>
  {% endif %}
  <script type="module" src="/assets/portfolio.js?v={{ assistantVersion }}"></script>
</body>
</html>
