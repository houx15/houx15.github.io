# Run bun run build first. Build from repository root.
# No .env file or credential is copied into the image.
FROM node:24-bookworm-slim
ENV NODE_ENV=production AGENT_BIND=0.0.0.0 AGENT_PORT=8788 AGENT_ENABLED=0
WORKDIR /app
COPY --chown=node:node package.json ./package.json
COPY --chown=node:node server/agent-*.mjs server/content-agent.mjs ./server/
COPY --chown=node:node src/assets/agent-tools.js src/assets/knowledge.js src/assets/knowledge-zh.js src/assets/biography.js ./src/assets/
COPY --chown=node:node _site/assets/agent-corpus.json ./_site/assets/agent-corpus.json
COPY --chown=node:node scripts/check-agent-config.mjs ./scripts/check-agent-config.mjs
USER node
EXPOSE 8788
CMD ["node", "server/agent-index.mjs"]
